find_package(CreateVersion REQUIRED)
find_package(Git REQUIRED)

GetGitInfo(${CMAKE_SOURCE_DIR} GIT_VERSION_INFO)

SET( MAJOR_VERSION    @MAJOR_VERSION@ )
SET( MINOR_VERSION    @MINOR_VERSION@ )
SET( PATCH_VERSION    @PATCH_VERSION@ )
SET( APP_NAME         "@APP_NAME@" )
SET( VENDOR           "@VENDOR@" )
SET( HOMEPAGE         "@HOMEPAGE@" )
SET( PRODUCT_HOMEPAGE "@PRODUCT_HOMEPAGE@" )
SET( EMAIL            "@EMAIL@" )

CreateVersion(
    MAJOR ${MAJOR_VERSION} 
    MINOR ${MINOR_VERSION} 
    PATCH ${PATCH_VERSION}
    GITVERSION ${GIT_VERSION_INFO_REV}
    AHEAD ${GIT_VERSION_INFO_AHEAD}
    DIFF  ${GIT_VERSION_INFO_DIFF}
    START_YEAR ${GIT_VERSION_INFO_START_YEAR}
    APP_NAME ${APP_NAME} 
    VENDOR ${VENDOR} 
    HOMEPAGE ${HOMEPAGE} 
    PRODUCT_HOMEPAGE ${PRODUCT_HOMEPAGE} 
    EMAIL ${EMAIL} 
    SUBDIR ON
)

