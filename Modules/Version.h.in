#ifndef __VERSION_H
#define __VERSION_H

#include <cstdint>

#ifdef QT_VERSION
    #include <QString>
    #include <QStringLiteral>
    #include <QDateTime>
    #include <QCoreApplication>
    #include <QTimeZone>
    #define TRANSLATE( str ) QObject::tr( str )
using TStringType = QString;
#else
    #include <string>
    #define TRANSLATE( str ) str
using TStringType = std::string;
#endif

#include <cstdint>

namespace NVersion
{
    inline const int MAJOR_VERSION = @VERSION_FILE_MAJOR_VERSION@;
    inline const int MINOR_VERSION = @VERSION_FILE_MINOR_VERSION@;
    inline const TStringType PATCH_VERSION = TRANSLATE( "@VERSION_FILE_PATCH_VERSION@" );   // string from git
    inline const uint16_t PATCH_VERSION_LOW = @VERSION_FILE_PATCH_VERSION_HIGH@;   // string from git
    inline const uint16_t PATCH_VERSION_HIGH = @VERSION_FILE_PATCH_VERSION_LOW@;   // string from git

    inline const bool MODIFIED = @VERSION_FILE_DIFF@;
    inline const TStringType AHEAD = TRANSLATE( "@VERSION_FILE_AHEAD@" );
    inline const TStringType APP_NAME = TRANSLATE( "@VERSION_FILE_APP_NAME@" );
    inline const TStringType VENDOR = TRANSLATE( "@VERSION_FILE_VENDOR@" );
    inline const TStringType HOMEPAGE = TRANSLATE( "@VERSION_FILE_HOMEPAGE@" );
    inline const TStringType PRODUCT_HOMEPAGE = TRANSLATE( "@VERSION_FILE_PRODUCT_HOMEPAGE@" );
    inline const TStringType EMAIL = TRANSLATE( "@VERSION_FILE_EMAIL@" );
    inline const TStringType COPYRIGHT = TRANSLATE( "@VERSION_FILE_COPYRIGHT@" );
    inline const TStringType BUILD_DATE_UTC = TRANSLATE( "@VERSION_FILE_BUILD_DATE@" ) + TRANSLATE( "Z" );   // IN UTC
    inline const TStringType BUILD_TIME_UTC = TRANSLATE( "@VERSION_FILE_BUILD_TIME@" ) + TRANSLATE( "UTCZ" );   // IN UTC

    template< typename T >
    TStringType toString( T value )
    {
#ifdef QT_VERSION
        return QString::number( value );
#else
        return std::to_string( value );
#endif
    }

    template< typename T >
    bool isEmpty( const T & value )
    {
#ifdef QT_VERSION
        return value.isEmpty();
#else
        return value.empty();
#endif
    }

#ifdef QT_VERSION
    inline QDateTime buildDateTime( bool localTime )
    {
        static QDateTime sBuildDateTime;
        if ( !sBuildDateTime.isValid() )
        {
            sBuildDateTime = QDateTime::fromString( NVersion::BUILD_DATE_UTC + QStringLiteral( " " ) + NVersion::BUILD_TIME_UTC, QStringLiteral( "MM/dd/yyyyZ HH:mm:ssUTCZ" ) );
            Q_ASSERT( sBuildDateTime.isValid() );
            sBuildDateTime.setTimeZone( QTimeZone::UTC );
        }

        auto retVal = sBuildDateTime;
        if ( localTime )
            retVal = retVal.toLocalTime();
        return retVal;
    }
#endif

    inline TStringType getBuildDateText( bool localTime, bool includeTZ, bool sortableDate )
    {
        TStringType retVal = TRANSLATE( " Build Date: " );
#ifdef QT_VERSION
        auto format = QLocale().dateFormat();
        if ( sortableDate )
            format = QStringLiteral( "yyyyMMdd" );

        if ( includeTZ )
            format += QStringLiteral( " " ) + QLocale().timeFormat();


        auto buildDateTime = NVersion::buildDateTime( localTime );
        retVal += buildDateTime.toString( format );

        if ( includeTZ )
        {
            auto abbr = buildDateTime.timeZoneAbbreviation();
            if ( !abbr.isEmpty() )
            {
                auto tzString = abbr;
                if ( abbr.startsWith( TRANSLATE( "Pacific" ), Qt::CaseInsensitive )
                 || abbr.startsWith( TRANSLATE( "Mountain" ), Qt::CaseInsensitive )
                 || abbr.startsWith( TRANSLATE( "Central" ), Qt::CaseInsensitive )
                 || abbr.startsWith( TRANSLATE( "Eastern" ), Qt::CaseInsensitive ) )
                {
                    tzString = abbr.front().toUpper();
                    if ( buildDateTime.isDaylightTime() )
                        tzString += TRANSLATE( "DT" );
                    else
                        tzString += TRANSLATE( "ST" );
                }
                retVal += QStringLiteral( " " ) +  tzString;
            }
        }
#else
        (void)sortableDate;
        (void)localTime;
        if ( !isEmpty( BUILD_DATE_UTC ) )
        {
            retVal += BUILD_DATE_UTC;
            if ( !isEmpty( TIME_DATE_UTC )
                retVal +=  BUILD_TIME_UTC;
        }
        else
            retVal += "<UNKNOWN>";
#endif
        return retVal;
    }

    inline TStringType getVersionText( bool full )
    {
        auto retVal = toString( MAJOR_VERSION ) + TRANSLATE( "." );
#ifdef VERSION_FILE_FORCE_TWODIGITS_MINOR
        if ( MINOR_VERSION < 10 )
            retVal += '0';
#endif
        retVal += toString( MINOR_VERSION );
        if ( full )
            retVal += TRANSLATE( "." ) + PATCH_VERSION;
        if ( MODIFIED )
            retVal += TRANSLATE( "*" );
        if ( !isEmpty( AHEAD ) && !MODIFIED )
            retVal += TRANSLATE( "*" );
        retVal += AHEAD;
        return retVal;
    }

    inline TStringType getVersionTextEX( bool localTime, bool full, bool sortableDate )
    {
        auto retVal = getVersionText( full );
        if ( full )
        {
            auto dateString = getBuildDateText( localTime, full, sortableDate );
            if ( !isEmpty( dateString ) )
                retVal += TRANSLATE( " - " );
            retVal += dateString;
        }

        return retVal;
    }

    inline TStringType getWindowTitle( bool verbose=true, bool homePage=true )
    {
        auto retVal = APP_NAME;
        if ( verbose )
        {
            retVal += TRANSLATE( " -" );
        }
        retVal += TRANSLATE( " v" )+ getVersionTextEX( true, true, false );
        if ( verbose && homePage )
        {
            retVal += TRANSLATE( " - https://" ) + HOMEPAGE;
        }
        return retVal;
    }

#ifdef QT_VERSION
    inline void setupApplication( QCoreApplication &appl, bool useProductHomepage )
    {
        appl.setApplicationName( APP_NAME );
        appl.setApplicationVersion( getVersionTextEX( false, true, false ) );
        appl.setOrganizationName( VENDOR );
        appl.setOrganizationDomain( useProductHomepage ? PRODUCT_HOMEPAGE : HOMEPAGE );
    }
#endif
}

#endif
