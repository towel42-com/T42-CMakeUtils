#ifndef __VERSION_H
#define __VERSION_H

#include <cstdint>

#ifdef QT_VERSION
    #include <QString>
    #include <QStringLiteral>
    #include <QDateTime>
    #include <QApplication>
    #include <QTimeZone>
using TStringType = QString;
#else
    #include <string>
using TStringType = std::string;
#endif

#include <cstdint>

namespace NVersion
{
    inline TStringType fromStringLiteral( const char * text )
    {
    #ifdef QT_VERSION
        return QString::fromLocal8Bit( text );
    #else
        return TStringType( text );
    #endif
    }

    inline const int MAJOR_VERSION = @VERSION_FILE_MAJOR_VERSION@;
    inline const int MINOR_VERSION = @VERSION_FILE_MINOR_VERSION@;
    inline const TStringType PATCH_VERSION = fromStringLiteral( "@VERSION_FILE_PATCH_VERSION@" );   // string from git
    inline const uint16_t PATCH_VERSION_LOW = @VERSION_FILE_PATCH_VERSION_HIGH@;   // string from git
    inline const uint16_t PATCH_VERSION_HIGH = @VERSION_FILE_PATCH_VERSION_LOW@;   // string from git

    inline const bool MODIFIED = @VERSION_FILE_DIFF@;
    inline const TStringType AHEAD = fromStringLiteral( "@VERSION_FILE_AHEAD@" );
    inline const TStringType APP_NAME = fromStringLiteral( "@VERSION_FILE_APP_NAME@" );
    inline const TStringType VENDOR = fromStringLiteral( "@VERSION_FILE_VENDOR@" );
    inline const TStringType HOMEPAGE = fromStringLiteral( "@VERSION_FILE_HOMEPAGE@" );
    inline const TStringType PRODUCT_HOMEPAGE = fromStringLiteral( "@VERSION_FILE_PRODUCT_HOMEPAGE@" );
    inline const TStringType EMAIL = fromStringLiteral( "@VERSION_FILE_EMAIL@" );
    inline const TStringType COPYRIGHT = fromStringLiteral( "@VERSION_FILE_COPYRIGHT@" );
    inline const TStringType BUILD_DATE_UTC = fromStringLiteral( "@VERSION_FILE_BUILD_DATE@" ) + fromStringLiteral( "Z" );   // IN UTC
    inline const TStringType BUILD_TIME_UTC = fromStringLiteral( "@VERSION_FILE_BUILD_TIME@" ) + fromStringLiteral( "Z" );   // IN UTC

    template< typename T >
    TStringType toString( T value )
    {
#ifdef QT_VERSION
        return QString::number( value );
#else
        return std::to_string( value );
#endif
    }

    inline bool isEmpty( const TStringType &value )
    {
#ifdef QT_VERSION
        return value.isEmpty();
#else
        return value.empty();
#endif
    }

    
    inline TStringType buildDateTime( bool localTime, bool sortableDate )
    {
        TStringType retVal = fromStringLiteral( " Build Date: " );
#ifdef QT_VERSION
        static QDateTime sBuildDateTime;
        if ( !sBuildDateTime.isValid() )
        {
            sBuildDateTime = QDateTime::fromString( NVersion::BUILD_DATE_UTC + QStringLiteral( " " ) + NVersion::BUILD_TIME_UTC, QStringLiteral( "MM/dd/yyyyZ HH:mm:ssZ" ) );
            sBuildDateTime.setTimeZone( QTimeZone::UTC );
        }
        
        auto buildDateTime = sBuildDateTime;
        if ( localTime )
            buildDateTime = buildDateTime.toLocalTime();

        if ( sortableDate )
            retVal += buildDateTime.toString( QStringLiteral( "yyyyMMdd" ) );
        else
            retVal += buildDateTime.toString( QStringLiteral( "MM/dd/yyyy" ) );
#else
        (void)sortableDate;
        (void)localTime;
        if ( !isEmpty( BUILD_DATE_UTC ) )
            retVal += BUILD_DATE_UTC;
#endif
        return retVal;
    }

    inline TStringType getVersionText( bool localTime, bool full, bool sortableDate )
    {
        auto retVal = toString( MAJOR_VERSION ) + fromStringLiteral( "." );
#ifdef VERSION_FILE_FORCE_TWODIGITS_MINOR
        if ( MINOR_VERSION < 10 )
            retVal += '0';
#endif
        retVal += toString( MINOR_VERSION );
        if ( full )
            retVal += fromStringLiteral( "." ) + PATCH_VERSION;
        if ( MODIFIED )
            retVal += fromStringLiteral( "*" );
        if ( !isEmpty( AHEAD ) && !MODIFIED )
            retVal += fromStringLiteral( "*" );
        retVal += AHEAD;

        retVal += fromStringLiteral( " " ) + NVersion::buildDateTime( localTime, sortableDate );
        return retVal;
    }

    inline TStringType getWindowTitle()
    {
        auto retVal = APP_NAME + fromStringLiteral( " v" )+ getVersionText( true, true, true ) + fromStringLiteral( " - http://" ) + HOMEPAGE;
        return retVal;
    }

#ifdef QT_VERSION
    inline void setupApplication( QCoreApplication &appl, bool useProductHomepage )
    {
        appl.setApplicationName( APP_NAME );
        appl.setApplicationVersion( getVersionText( false, true, true ) );
        appl.setOrganizationName( VENDOR );
        appl.setOrganizationDomain( useProductHomepage ? PRODUCT_HOMEPAGE : HOMEPAGE );
    }
#endif
}

#endif
