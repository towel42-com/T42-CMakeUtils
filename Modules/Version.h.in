#ifndef __VERSION_H
#define __VERSION_H

#include "T42-Utils/VersionInfoData.h"

#include <QString>
#include <QStringLiteral>
#include <cstdint>
#include <memory>

namespace NVersion
{
    class CVersionInfoData : public NTowel42Utils::CVersionInfoData
    {
    public:
        virtual int majorVersion() const override { return @VERSION_FILE_MAJOR_VERSION@; }
        virtual int minorVersion() const override { return @VERSION_FILE_MINOR_VERSION@; }
        virtual int patchVersion() const override { return @VERSION_FILE_PATCH_VERSION@; }
        virtual QString gitVersion() const override { return QStringLiteral( "@VERSION_FILE_GIT_VERSION@" ); }
        virtual uint16_t patchVersionLow() const override { return @VERSION_FILE_PATCH_VERSION_LOW@; }
        virtual uint16_t patchVersionHigh() const override { return @VERSION_FILE_PATCH_VERSION_HIGH@; }
        virtual bool modified() const override { return @VERSION_FILE_DIFF@; }
        virtual QString ahead() const override { return QStringLiteral( "@VERSION_FILE_AHEAD@" ); }
        virtual QString appName() const override { return QStringLiteral( "@VERSION_FILE_APP_NAME@" ); }
        virtual QString vendor() const override { return QStringLiteral( "@VERSION_FILE_VENDOR@" ); }
        virtual QString homePage() const override { return QStringLiteral( "@VERSION_FILE_HOMEPAGE@" ); }
        virtual QString productHomePage() const override { return QStringLiteral( "@VERSION_FILE_PRODUCT_HOMEPAGE@" ); }
        virtual QString email() const override { return QStringLiteral( "@VERSION_FILE_EMAIL@" ); }
        virtual QString copyright() const override { return QStringLiteral( "@VERSION_FILE_COPYRIGHT@" ); }
        virtual QString buildDateUTC() const override { return QStringLiteral( "@VERSION_FILE_BUILD_DATE@" ) + QStringLiteral( "Z" ); }
        virtual QString buildTimeUTC() const override { return QStringLiteral( "@VERSION_FILE_BUILD_TIME@" ) + QStringLiteral( "Z" ); }
    };

    inline std::shared_ptr< CVersionInfoData >
    versionInfo()
    {
        static std::shared_ptr< CVersionInfoData > sVersionInfo = std::make_shared< CVersionInfoData >();
        return sVersionInfo;
    }
}

#endif
